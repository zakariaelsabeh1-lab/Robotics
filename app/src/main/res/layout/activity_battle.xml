<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Top HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@color/colorSurface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔️ BATTLE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorDanger"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvTurn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/gold"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Battle scene -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.zakariaelsabeh.robofight.ui.battle.BattleView
            android:id="@+id/battleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Damage numbers -->
        <TextView
            android:id="@+id/tvPlayerDamage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorDanger"
            android:shadowColor="#000000"
            android:shadowDx="2" android:shadowDy="2" android:shadowRadius="4"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="40dp"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/tvEnemyDamage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/colorDanger"
            android:shadowColor="#000000"
            android:shadowDx="2" android:shadowDy="2" android:shadowRadius="4"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="40dp"
            android:visibility="invisible"/>

    </FrameLayout>

    <!-- Battle controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/colorSurface">

        <Button
            android:id="@+id/btnAttack"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="2"
            android:text="⚔️\nATTACK!"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_battle_bg"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnSpecial"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="2"
            android:text="⚡\nSPECIAL!"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_special_bg"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnBlock"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1.5"
            android:text="🛡️\nBLOCK"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_block_bg"/>

    </LinearLayout>
</LinearLayout>
