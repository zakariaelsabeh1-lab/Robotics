<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Top HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical"
        android:background="@color/colorSurface">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FIGHT"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorDanger"
            android:letterSpacing="0.15"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvTurn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/gold"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Battle scene -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.zakariaelsabeh.robofight.ui.battle.BattleView
            android:id="@+id/battleView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Player damage number -->
        <TextView
            android:id="@+id/tvPlayerDamage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="@color/colorDanger"
            android:shadowColor="#000000"
            android:shadowDx="2" android:shadowDy="2" android:shadowRadius="6"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="30dp"
            android:visibility="invisible"/>

        <!-- Enemy damage number -->
        <TextView
            android:id="@+id/tvEnemyDamage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="@color/colorDanger"
            android:shadowColor="#000000"
            android:shadowDx="2" android:shadowDy="2" android:shadowRadius="6"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="30dp"
            android:visibility="invisible"/>

        <!-- COMBO counter (bottom-left) -->
        <TextView
            android:id="@+id/tvCombo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:shadowColor="#FF6F00"
            android:shadowDx="0" android:shadowDy="0" android:shadowRadius="10"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <!-- CRITICAL pop-up (center) -->
        <TextView
            android:id="@+id/tvCritical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRITICAL!"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="@color/neonRed"
            android:shadowColor="#FF0000"
            android:shadowDx="0" android:shadowDy="0" android:shadowRadius="16"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Battle controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/colorSurface">

        <Button
            android:id="@+id/btnAttack"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="2"
            android:text="ATTACK"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_battle_bg"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnSpecial"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="2"
            android:text="SPECIAL!"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_special_bg"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnBlock"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1.5"
            android:text="BLOCK"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_block_bg"/>

    </LinearLayout>
</LinearLayout>
