<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ RoboFight ⚡"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:shadowColor="#FF6F00"
            android:shadowDx="0" android:shadowDy="2" android:shadowRadius="8"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/colorSecondary"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvRobotName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="4dp"/>

        <com.zakariaelsabeh.robofight.ui.views.RobotIconView
            android:id="@+id/ivMenuRobot"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStats"
            style="@style/CardGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold"/>

                <TextView
                    android:id="@+id/tvStars"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold"/>

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@color/colorSecondary"/>

                <TextView
                    android:id="@+id/tvWins"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@color/colorSuccess"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="⚔️  PLAY!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_battle_bg"
            android:layout_marginTop="20dp"/>

        <Button
            android:id="@+id/btnChangeRobot"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🤖  Change Robot"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_primary_bg"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚙️  Settings"
            android:textSize="18sp"
            android:textColor="@color/colorSecondary"
            android:background="@drawable/card_dark"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exit"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            style="?attr/borderlessButtonStyle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
