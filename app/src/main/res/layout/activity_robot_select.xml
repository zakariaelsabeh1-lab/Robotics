<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_menu">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/colorText"
            style="?attr/borderlessButtonStyle"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Choose Your Robot!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Preview panel -->
    <com.google.android.material.card.MaterialCardView
        style="@style/CardGame"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.zakariaelsabeh.robofight.ui.views.RobotIconView
                android:id="@+id/ivPreviewRobot"
                android:layout_width="160dp"
                android:layout_height="match_parent"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPreviewName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/gold"/>

                <TextView
                    android:id="@+id/tvPreviewTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvPreviewSpecial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/colorSecondary"
                    android:layout_marginTop="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <TextView android:id="@+id/tvStatHp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:textColor="@color/colorSuccess"/>
                    <ProgressBar android:id="@+id/barHp" style="?android:progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="8dp"
                        android:max="160" android:progressTint="@color/colorSuccess"/>

                    <TextView android:id="@+id/tvStatAttack" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:textColor="@color/colorDanger" android:layout_marginTop="4dp"/>
                    <ProgressBar android:id="@+id/barAttack" style="?android:progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="8dp"
                        android:max="50" android:progressTint="@color/colorDanger"/>

                    <TextView android:id="@+id/tvStatDefense" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:textColor="@color/colorSecondary" android:layout_marginTop="4dp"/>
                    <ProgressBar android:id="@+id/barDefense" style="?android:progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="8dp"
                        android:max="30" android:progressTint="@color/colorSecondary"/>

                    <TextView android:id="@+id/tvStatSpeed" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:textColor="@color/gold" android:layout_marginTop="4dp"/>
                    <ProgressBar android:id="@+id/barSpeed" style="?android:progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="8dp"
                        android:max="100" android:progressTint="@color/gold"/>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRobots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnSelect"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SELECT THIS ROBOT! ✅"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/colorText"
        android:background="@drawable/btn_battle_bg"
        android:layout_margin="16dp"/>

</LinearLayout>
