<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="20sp"
                android:textColor="@color/colorText"
                style="?attr/borderlessButtonStyle"/>

            <TextView
                android:id="@+id/tvCityTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏙️ Robot City"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/gold"
                android:gravity="center"/>

        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Where do you want to go?"
            android:textSize="18sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvPlayerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/gold"
            android:layout_marginTop="8dp"/>

        <!-- Battle Arena - Biggest button -->
        <Button
            android:id="@+id/btnBattleArena"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="⚔️ BATTLE ARENA"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_battle_bg"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fight robot enemies in epic battles!"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnExplore"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="🏙️\nExplore City"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:background="@drawable/btn_primary_bg"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/btnTreasure"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:text="💎\nTreasure Hunt"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:background="@drawable/btn_primary_bg"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnWorkshop"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="🔧 WEAPON WORKSHOP"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:background="@drawable/btn_primary_bg"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Craft and equip powerful weapons!"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
